# Supabase project URL, e.g. https://xxxxx.supabase.co
SUPABASE_URL=

# Keep this secret. Add only in Vercel Environment Variables.
SUPABASE_SERVICE_ROLE_KEY=

# Shared key used by ESP32 when POSTing status updates.
DEVICE_API_KEY=change-this-to-a-long-random-secret

# Password for https://your-project.vercel.app/admin
# Use a strong password (12+ characters recommended).
ADMIN_PASSWORD=change-this-to-a-strong-admin-password

# Public URL after Vercel deployment. Used by /qr
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A HTTPS site URL works well with Apple Web Push.
VAPID_SUBJECT=https://your-project.vercel.app
